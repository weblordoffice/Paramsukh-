{
  "expo": {
    "name": "Paramsukh Online Gurukul",
    "slug": "paramsukh-online-gurukul",
    "version": "1.0.10",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "paramsukh",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "buildNumber": "10",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "tez",
          "phonepe",
          "paytmmp",
          "upi"
        ]
      },
      "bundleIdentifier": "com.paramsukh.onlinegurukul"
    },
    "android": {
      "package": "com.paramsukh.onlinegurukul",
      "versionCode": 10,
      "googleServicesFile": "./google-services.json",
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#A070B0",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/logo-n-splash.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#ffffff"
          }
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#F1842D",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "apiUrl": "https://api.paramsukhonlinegurukul.com",
      "privacyPolicyUrl": "https://ps-pp.vercel.app/",
      "EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_test_ZnJlZS1tYW5hdGVlLTUzLmNsZXJrLmFjY291bnRzLmRldiQ",
      "eas": {
        "projectId": "d49ac848-8a56-4fe6-bfb3-7b4ad8a7a570"
      }
    },
    "owner": "webvision",
    "runtimeVersion": "1.0.9",
    "updates": {
      "url": "https://u.expo.dev/d49ac848-8a56-4fe6-bfb3-7b4ad8a7a570"
    }
  }
}
