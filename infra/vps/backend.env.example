NODE_ENV=production
PORT=3000

# Required
# Production database. Keep local/dev pointed at a DIFFERENT database (e.g. psog_dev).
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/psog
JWT_SECRET=replace_with_64_char_random_secret
ADMIN_API_KEY=replace_with_strong_admin_api_key

# Database names used by destructive-script safety guards and copy scripts.
PROD_MONGO_DB=psog
DEV_MONGO_DB=psog_dev

# Strongly recommended for admin module
ADMIN_COOKIE_PASSWORD=replace_with_64_char_random_secret
ADMIN_SESSION_SECRET=replace_with_64_char_random_secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_strong_admin_password

# OAuth (if using Google login)
GOOGLE_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_web_client_secret

# OTP provider
FAST2SMS_API_KEY=your_fast2sms_api_key

# Cloudinary (images)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Cloudflare R2 (videos)
# Required for video uploads. If these are only partially set (e.g. credentials
# present but R2_PUBLIC_URL missing), /api/upload/video returns HTTP 500.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_ENDPOINT=https://<accountId>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-<hash>.r2.dev
R2_REGION=auto

# Payments
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Webhook URLs to configure in Razorpay Dashboard:
#   https://api.paramsukhonlinegurukul.com/api/payments/webhook     (memberships, bookings, orders)
#   https://api.paramsukhonlinegurukul.com/api/podcasts/webhook/razorpay  (podcast purchases)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# NEVER enable in production.
RAZORPAY_TEST_MODE=false

# Email
RESEND_API_KEY=your_resend_api_key


